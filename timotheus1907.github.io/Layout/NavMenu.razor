<nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom sticky-top">
    <div class="container">
        <a class="navbar-brand d-flex align-items-baseline gap-2 font-monospace" href="">
            <img class="align-self-center" src="favicon.svg" alt="" width="36" height="36" />
            <span class="cursor fs-2">Timothy's Terminal</span>
            <small class="text-body-secondary d-none d-sm-inline fs-6">portfolio</small>
        </a>
        <button class="navbar-toggler" type="button" aria-label="Toggle navigation"
                @onclick="() => open = !open">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse @(open ? "show" : null)">
            <ul class="navbar-nav ms-auto align-items-lg-center" @onclick="CloseAll">
                <li class="nav-item"><NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink></li>

                <li class="nav-item dropdown">
                    <div class="d-flex align-items-center">
                        <NavLink class="nav-link pe-1" href="projects">Projects</NavLink>
                        <button class="nav-link dropdown-toggle px-2" type="button"
                                aria-label="Toggle projects menu"
                                aria-expanded="@(projectsOpen ? "true" : "false")"
                                @onclick="ToggleProjects" @onclick:stopPropagation="true"></button>
                    </div>
                    <ul class="dropdown-menu @(projectsOpen ? "show" : null)" data-bs-popper="static">
                        <li>
                            <a class="dropdown-item" href="https://<username>.github.io/daily-game/"
                               target="_blank" rel="noopener">Daily Game</a>
                        </li>
                        @* add more projects here *@
                    </ul>
                </li>
                
                <li class="nav-item"><NavLink class="nav-link" href="about">About</NavLink></li>
            </ul>
        </div>
    </div>

    @if (projectsOpen)
    {
        <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index:-1" @onclick="CloseAll"></div>
    }
</nav>

@code {
    private bool open;
    private bool projectsOpen;

    private void ToggleProjects() => projectsOpen = !projectsOpen;

    private void CloseAll()
    {
        open = false;
        projectsOpen = false;
    }
}